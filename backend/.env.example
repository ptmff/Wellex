# Backend environment (do not commit real secrets)

NODE_ENV=development
PORT=3000
API_VERSION=v1

DB_HOST=localhost
DB_PORT=5433
DB_NAME=prediction_market
DB_USER=postgres
DB_PASSWORD=secret

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=local-dev-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-chars!
ADMIN_SECRET_KEY=admin-local-dev-key

INITIAL_USER_BALANCE=1000
CURRENCY_CODE=WX
SEED_ON_START=false
INGEST_ON_START=false

# mock (instant credit) | yookassa (hosted checkout)
PAYMENT_PROVIDER=mock
PAYMENT_RETURN_URL=http://localhost:8080/payment/result
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# HTTP notifications URL: https://<public-host>/api/v1/economy/webhooks/yookassa

# Ads: mock countdown locally; yandex after site is approved in РСЯ
AD_PROVIDER=mock
AD_REWARD_AMOUNT=100
AD_REWARD_COOLDOWN_HOURS=4
AD_REWARD_MAX_PER_DAY=4
AD_MIN_WATCH_SECONDS=10
# YANDEX_RTB_BLOCK_ID=R-A-XXXXXXX-Y
