          "content": {
            "size": 43154,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ВЕЛЛЕКС — вероятность становится ценой</title>\n<meta name=\"description\" content=\"Веллекс — платформа прогнозных рынков. Торгуйте вероятностями событий в реальном времени: биржевой стакан, портфель, лидерборд. Игровая валюта WX.\">\n<meta name=\"theme-color\" content=\"#12141a\">\n<link rel=\"icon\" href=\"assets/favicon.png\" type=\"image/png\">\n<link rel=\"apple-touch-icon\" href=\"assets/logo-180.png\">\n\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"ВЕЛЛЕКС — вероятность становится ценой\">\n<meta property=\"og:description\" content=\"Платформа прогнозных рынков: торгуйте вероятностями событий в реальном времени.\">\n<meta property=\"og:image\" content=\"assets/logo.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n/* ─────────────────────────────  БРЕНД-ТОКЕНЫ  ───────────────────────────── */\n:root{\n  --bg:        hsl(225 15% 8%);\n  --surface:   hsl(225 15% 11%);\n  --surface-2: hsl(225 14% 14%);\n  --fg:        hsl(210 20% 95%);\n  --muted:     hsl(215 12% 62%);\n  --dim:       hsl(215 12% 42%);\n  --accent:    hsl(160 84% 44%);\n  --accent-dim:hsl(160 84% 44% / .12);\n  --red:       hsl(0 72% 55%);\n  --red-dim:   hsl(0 72% 55% / .12);\n  --line:      hsl(210 20% 95% / .09);\n  --line-soft: hsl(210 20% 95% / .05);\n  --r:         4px;\n  --r-lg:      6px;\n  --sans:'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  --mono:'Roboto Mono',ui-monospace,SFMono-Regular,Menlo,monospace;\n  --maxw:1200px;\n  --ease:cubic-bezier(.2,.7,.3,1);\n}\n\n*,*::before,*::after{box-sizing:border-box}\nhtml{scroll-behavior:smooth;-webkit-text-size-adjust:100%}\nbody{\n  margin:0;background:var(--bg);color:var(--fg);\n  font-family:var(--sans);font-weight:500;font-size:17px;line-height:1.6;\n  -webkit-font-smoothing:antialiased;overflow-x:hidden;\n}\nimg{max-width:100%;display:block}\na{color:inherit;text-decoration:none}\nh1,h2,h3{margin:0;font-weight:800;letter-spacing:-.02em;line-height:1.08}\np{margin:0}\n::selection{background:var(--accent);color:hsl(225 15% 8%)}\n\n/* фоновая атмосфера */\n.bg-fx{position:fixed;inset:0;pointer-events:none;z-index:0}\n.bg-fx::before{\n  content:'';position:absolute;inset:0;\n  background-image:linear-gradient(var(--line-soft) 1px,transparent 1px),\n                   linear-gradient(90deg,var(--line-soft) 1px,transparent 1px);\n  background-size:88px 88px;\n  mask-image:radial-gradient(120% 80% at 50% 0%,#000 10%,transparent 75%);\n  -webkit-mask-image:radial-gradient(120% 80% at 50% 0%,#000 10%,transparent 75%);\n}\n.bg-fx::after{\n  content:'';position:absolute;top:-380px;left:50%;transform:translateX(-50%);\n  width:1100px;height:820px;border-radius:50%;\n  background:radial-gradient(closest-side,hsl(160 84% 44% / .16),transparent 70%);\n  filter:blur(30px);\n}\n.wrap{position:relative;z-index:1}\n.container{width:100%;max-width:var(--maxw);margin:0 auto;padding-inline:24px}\n\n/* служебные */\n.mono{font-family:var(--mono);font-weight:400}\n.eyebrow{\n  font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;\n  color:var(--dim);display:flex;align-items:center;gap:10px;\n}\n.eyebrow::before{content:'';width:22px;height:1px;background:var(--accent);opacity:.7}\n.muted{color:var(--muted)}\n.accent{color:var(--accent)}\n\n/* кнопки */\n.btn{\n  display:inline-flex;align-items:center;justify-content:center;gap:9px;\n  font-family:var(--sans);font-weight:700;font-size:15px;letter-spacing:.01em;\n  padding:13px 24px;border-radius:100px;border:1px solid transparent;cursor:pointer;\n  transition:transform .25s var(--ease),background .25s var(--ease),border-color .25s var(--ease),box-shadow .25s var(--ease);\n  white-space:nowrap;\n}\n.btn:hover{transform:translateY(-2px)}\n.btn-primary{background:var(--accent);color:hsl(225 15% 8%);box-shadow:0 0 0 0 hsl(160 84% 44% / .35)}\n.btn-primary:hover{box-shadow:0 12px 34px -10px hsl(160 84% 44% / .65)}\n.btn-ghost{border-color:var(--line);color:var(--fg);background:hsl(210 20% 95% / .02)}\n.btn-ghost:hover{border-color:hsl(160 84% 44% / .55);color:var(--accent)}\n.btn-lg{padding:16px 30px;font-size:16px}\n\n/* ─────────────────────────────  ШАПКА  ───────────────────────────── */\n.nav{\n  position:sticky;top:0;z-index:50;\n  border-bottom:1px solid transparent;transition:.3s var(--ease);\n}\n.nav.scrolled{\n  background:hsl(225 15% 8% / .78);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);\n  border-bottom-color:var(--line);\n}\n.nav-in{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}\n.brand{display:flex;align-items:center;gap:12px}\n.brand img{width:38px;height:38px;object-fit:contain}\n.brand span{font-weight:700;font-size:19px;letter-spacing:.1em}\n.nav-links{display:flex;gap:30px;font-size:15px;font-weight:600;color:var(--muted)}\n.nav-links a{position:relative;transition:color .2s}\n.nav-links a::after{\n  content:'';position:absolute;left:0;right:100%;bottom:-6px;height:1px;\n  background:var(--accent);transition:right .3s var(--ease);\n}\n.nav-links a:hover{color:var(--fg)}\n.nav-links a:hover::after{right:0}\n.nav-cta{display:flex;align-items:center;gap:12px}\n\n/* ─────────────────────────────  ГЕРОЙ  ───────────────────────────── */\n.hero{padding:86px 0 40px}\n.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}\n.pill{\n  display:inline-flex;align-items:center;gap:9px;padding:7px 15px 7px 11px;\n  border:1px solid var(--line);border-radius:100px;\n  font-family:var(--mono);font-size:12.5px;color:var(--muted);letter-spacing:.03em;\n  background:hsl(210 20% 95% / .02);\n}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 hsl(160 84% 44% / .6);animation:pulse 2.4s infinite}\n@keyframes pulse{\n  0%{box-shadow:0 0 0 0 hsl(160 84% 44% / .55)}\n  70%{box-shadow:0 0 0 8px hsl(160 84% 44% / 0)}\n  100%{box-shadow:0 0 0 0 hsl(160 84% 44% / 0)}\n}\n.hero h1{font-size:clamp(42px,6.1vw,74px);margin:26px 0 0}\n.hero h1 .gl{\n  background:linear-gradient(96deg,var(--accent),hsl(168 70% 68%));\n  -webkit-background-clip:text;background-clip:text;color:transparent;\n}\n.hero-sub{margin-top:22px;font-size:19px;color:var(--muted);max-width:520px;line-height:1.62}\n.hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}\n.hero-note{margin-top:18px;font-family:var(--mono);font-size:12.5px;color:var(--dim);letter-spacing:.02em}\n\n/* карточка рынка */\n.card{\n  background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);\n}\n.market-card{padding:26px;position:relative;overflow:hidden;box-shadow:0 40px 90px -50px #000}\n.market-card::before{\n  content:'';position:absolute;inset:0;pointer-events:none;\n  background:radial-gradient(90% 60% at 100% 0%,hsl(160 84% 44% / .09),transparent 60%);\n}\n.mc-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;position:relative}\n.tag{\n  font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;\n  color:var(--accent);border:1px solid hsl(160 84% 44% / .35);background:var(--accent-dim);\n  padding:4px 10px;border-radius:100px;\n}\n.mc-q{font-size:21px;font-weight:700;line-height:1.32;margin-top:18px;letter-spacing:-.01em}\n.mc-price{display:flex;align-items:baseline;gap:12px;margin-top:20px}\n.mc-price b{font-family:var(--mono);font-weight:500;font-size:44px;letter-spacing:-.02em;color:var(--accent)}\n.chg{font-family:var(--mono);font-size:13px;color:var(--accent);background:var(--accent-dim);padding:3px 9px;border-radius:100px}\n.spark{margin:16px -4px 4px;height:78px;width:calc(100% + 8px)}\n.bar{height:8px;border-radius:100px;background:var(--red-dim);overflow:hidden;display:flex;margin-top:6px}\n.bar i{display:block;height:100%;background:var(--accent);border-radius:100px;width:0;transition:width 1.6s var(--ease)}\n.bar-legend{display:flex;justify-content:space-between;font-family:var(--mono);font-size:12.5px;margin-top:10px}\n.mc-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}\n.side{\n  font-family:var(--mono);font-size:14px;padding:13px;border-radius:var(--r);text-align:center;\n  border:1px solid;transition:.22s var(--ease);cursor:default;\n}\n.side-yes{color:var(--accent);border-color:hsl(160 84% 44% / .35);background:var(--accent-dim)}\n.side-yes:hover{background:hsl(160 84% 44% / .2)}\n.side-no{color:var(--red);border-color:hsl(0 72% 55% / .3);background:var(--red-dim)}\n.side-no:hover{background:hsl(0 72% 55% / .2)}\n.mc-foot{\n  display:flex;justify-content:space-between;margin-top:18px;padding-top:16px;\n  border-top:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--dim);\n}\n\n/* ─────────────────────────────  БЕГУЩАЯ СТРОКА  ───────────────────────────── */\n.ticker{\n  border-block:1px solid var(--line);margin-top:64px;overflow:hidden;\n  background:hsl(225 15% 10% / .5);\n  mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);\n  -webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);\n}\n.ticker-track{display:flex;width:max-content;animation:slide 46s linear infinite}\n.ticker:hover .ticker-track{animation-play-state:paused}\n@keyframes slide{to{transform:translateX(-50%)}}\n.tick{\n  display:flex;align-items:center;gap:12px;padding:15px 26px;\n  border-right:1px solid var(--line-soft);font-size:14.5px;white-space:nowrap;color:var(--muted);\n}\n.tick b{font-family:var(--mono);font-weight:500;font-size:14px;color:var(--fg)}\n.tick .up{color:var(--accent)}\n.tick .down{color:var(--red)}\n\n/* ─────────────────────────────  СЕКЦИИ  ───────────────────────────── */\nsection{padding:110px 0;position:relative}\n.sec-head{max-width:680px;margin-bottom:54px}\n.sec-head h2{font-size:clamp(30px,4vw,46px);margin-top:18px}\n.sec-head p{margin-top:18px;font-size:18px;color:var(--muted)}\n\n/* статистика */\n.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}\n.stat{background:var(--bg);padding:32px 26px}\n.stat b{display:block;font-family:var(--mono);font-weight:500;font-size:40px;letter-spacing:-.02em;color:var(--fg)}\n.stat span{display:block;margin-top:8px;font-size:14px;color:var(--muted)}\n\n/* шаги */\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n.step{padding:32px;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface);position:relative;overflow:hidden;transition:.35s var(--ease)}\n.step:hover{border-color:hsl(160 84% 44% / .4);transform:translateY(-4px)}\n.step-n{font-family:var(--mono);font-size:13px;color:var(--accent);letter-spacing:.12em}\n.step h3{font-size:21px;margin:16px 0 12px}\n.step p{color:var(--muted);font-size:15.5px}\n.step::after{\n  content:'';position:absolute;right:-40px;bottom:-60px;width:160px;height:160px;border-radius:50%;\n  background:radial-gradient(closest-side,hsl(160 84% 44% / .14),transparent);opacity:0;transition:opacity .35s\n}\n.step:hover::after{opacity:1}\n\n/* возможности */\n.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}\n.feat{background:var(--bg);padding:36px 30px;transition:background .3s var(--ease)}\n.feat:hover{background:var(--surface)}\n.feat-ico{\n  width:42px;height:42px;border-radius:var(--r);display:grid;place-items:center;\n  border:1px solid hsl(160 84% 44% / .3);background:var(--accent-dim);color:var(--accent);margin-bottom:20px;\n}\n.feat h3{font-size:18px;margin-bottom:10px}\n.feat p{color:var(--muted);font-size:15px}\n\n/* сплит-секция */\n.split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}\n.lb{padding:8px;border-radius:var(--r-lg);border:1px solid var(--line);background:var(--surface);box-shadow:0 40px 90px -55px #000}\n.lb-row{display:flex;align-items:center;gap:16px;padding:15px 18px;border-radius:var(--r);transition:background .25s}\n.lb-row+.lb-row{border-top:1px solid var(--line-soft)}\n.lb-row:hover{background:hsl(210 20% 95% / .03)}\n.lb-rank{font-family:var(--mono);font-size:13px;color:var(--dim);width:24px}\n.lb-av{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,hsl(160 84% 44% / .35),hsl(190 84% 46% / .2));border:1px solid var(--line);display:grid;place-items:center;font-size:13px;font-weight:700}\n.lb-name{flex:1;font-weight:600;font-size:15px}\n.lb-val{font-family:var(--mono);font-size:14px;color:var(--accent)}\n.lb-row.top .lb-rank{color:var(--accent)}\n.checklist{list-style:none;padding:0;margin:26px 0 0;display:flex;flex-direction:column;gap:14px}\n.checklist li{display:flex;gap:13px;align-items:flex-start;color:var(--muted);font-size:16px}\n.checklist svg{flex-shrink:0;margin-top:4px;color:var(--accent)}\n\n/* FAQ */\n.faq{border-top:1px solid var(--line)}\ndetails{border-bottom:1px solid var(--line);padding:0}\nsummary{\n  list-style:none;cursor:pointer;padding:24px 0;display:flex;justify-content:space-between;\n  align-items:center;gap:24px;font-size:18px;font-weight:700;letter-spacing:-.01em;transition:color .2s\n}\nsummary::-webkit-details-marker{display:none}\nsummary:hover{color:var(--accent)}\nsummary .pm{\n  flex-shrink:0;width:26px;height:26px;border:1px solid var(--line);border-radius:50%;\n  display:grid;place-items:center;font-family:var(--mono);font-size:16px;color:var(--muted);transition:.3s var(--ease)\n}\ndetails[open] summary .pm{transform:rotate(45deg);border-color:var(--accent);color:var(--accent)}\ndetails p{padding:0 46px 26px 0;color:var(--muted);font-size:16px}\n\n/* финальный CTA */\n.cta-box{\n  border:1px solid var(--line);border-radius:var(--r-lg);padding:72px 48px;text-align:center;\n  background:\n    radial-gradient(80% 120% at 50% 0%,hsl(160 84% 44% / .13),transparent 62%),\n    var(--surface);\n  position:relative;overflow:hidden;\n}\n.cta-box img{width:78px;height:78px;object-fit:contain;margin:0 auto 24px}\n.cta-box h2{font-size:clamp(30px,4.4vw,50px)}\n.cta-box p{margin:20px auto 0;max-width:520px;color:var(--muted);font-size:18px}\n.cta-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:36px}\n\n/* подвал */\nfooter{border-top:1px solid var(--line);padding:56px 0 40px;margin-top:0}\n.foot-top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap}\n.foot-brand{max-width:320px}\n.foot-brand p{margin-top:16px;color:var(--dim);font-size:14.5px}\n.foot-cols{display:flex;gap:64px;flex-wrap:wrap}\n.foot-col h4{font-family:var(--mono);font-weight:400;font-size:12px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase;margin:0 0 16px}\n.foot-col a{display:block;font-size:15px;color:var(--muted);margin-bottom:11px;transition:color .2s}\n.foot-col a:hover{color:var(--accent)}\n.foot-bot{\n  margin-top:48px;padding-top:26px;border-top:1px solid var(--line-soft);\n  display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;\n  font-family:var(--mono);font-size:12px;color:var(--dim);\n}\n.disclaimer{max-width:640px;line-height:1.7}\n\n/* cookie + согласие на Метрику */\n.cookie-banner{\n  position:fixed;left:0;right:0;bottom:0;z-index:100;\n  border-top:1px solid var(--line);\n  background:hsl(225 15% 8% / .94);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);\n  padding:16px 0 calc(16px + env(safe-area-inset-bottom,0));\n  transform:translateY(100%);opacity:0;pointer-events:none;\n  transition:transform .35s var(--ease),opacity .35s var(--ease);\n}\n.cookie-banner.is-visible{transform:translateY(0);opacity:1;pointer-events:auto}\n.cookie-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px}\n.cookie-text{max-width:640px;font-size:14px;color:var(--muted);line-height:1.55}\n.cookie-text strong{display:block;color:var(--fg);font-size:15px;margin-bottom:4px;font-weight:700}\n.cookie-text a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}\n.cookie-actions{display:flex;flex-wrap:wrap;gap:10px}\n.cookie-actions .btn{padding:10px 18px;font-size:14px}\n.btn-cookie-ghost{background:transparent;border-color:var(--line);color:var(--fg)}\n.btn-cookie-ghost:hover{border-color:hsl(160 84% 44% / .45);color:var(--accent)}\n\n/* появление при скролле */\n.rv{opacity:0;transform:translateY(22px);transition:opacity .7s var(--ease),transform .7s var(--ease)}\n.rv.in{opacity:1;transform:none}\n\n/* ─────────────────────────────  АДАПТИВ  ───────────────────────────── */\n@media (max-width:960px){\n  .hero-grid,.split{grid-template-columns:1fr;gap:44px}\n  .steps,.features{grid-template-columns:1fr 1fr}\n  .stats{grid-template-columns:1fr 1fr}\n  .nav-links{display:none}\n  section{padding:80px 0}\n}\n@media (max-width:640px){\n  body{font-size:16px}\n  .container{padding-inline:18px}\n  .hero{padding:52px 0 20px}\n  .steps,.features,.stats{grid-template-columns:1fr}\n  .nav-cta .btn-ghost{display:none}\n  .cta-box{padding:52px 22px}\n  .mc-price b{font-size:36px}\n  .foot-cols{gap:36px}\n  section{padding:68px 0}\n}\n@media (prefers-reduced-motion:reduce){\n  *{animation:none!important;transition:none!important}\n  .rv{opacity:1;transform:none}\n  html{scroll-behavior:auto}\n}\n</style>\n</head>\n<body>\n<div class=\"bg-fx\"></div>\n<div class=\"wrap\">\n\n<!-- ═════════════ ШАПКА ═════════════ -->\n<header class=\"nav\" id=\"nav\">\n  <div class=\"container nav-in\">\n    <a class=\"brand\" href=\"#top\">\n      <img src=\"assets/logo.png\" alt=\"Веллекс\" width=\"38\" height=\"38\">\n      <span>ВЕЛЛЕКС</span>\n    </a>\n    <nav class=\"nav-links\">\n      <a href=\"#how\">Как это работает</a>\n      <a href=\"#features\">Возможности</a>\n      <a href=\"#markets\">Рынки</a>\n      <a href=\"#faq\">Вопросы</a>\n    </nav>\n    <div class=\"nav-cta\">\n      <a class=\"btn btn-ghost\" href=\"#cta\">Войти</a>\n      <a class=\"btn btn-primary\" href=\"#cta\">Открыть рынок →</a>\n    </div>\n  </div>\n</header>\n\n<!-- ═════════════ ГЕРОЙ ═════════════ -->\n<main id=\"top\">\n<div class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div>\n      <span class=\"pill\"><i class=\"dot\"></i> Рынки обновляются в реальном времени</span>\n      <h1>Вероятность<br>становится <span class=\"gl\">ценой</span>.</h1>\n      <p class=\"hero-sub\">\n        Веллекс — платформа прогнозных рынков. Выбирайте исход события, покупайте долю\n        по текущей вероятности и закрывайте позицию, когда рынок согласится с вами.\n      </p>\n      <div class=\"hero-actions\">\n        <a class=\"btn btn-primary btn-lg\" href=\"#cta\">Начать торговать</a>\n        <a class=\"btn btn-ghost btn-lg\" href=\"#how\">Как это работает</a>\n      </div>\n      <p class=\"hero-note\">Игровая валюта WX · без вложений на старте · 18+</p>\n    </div>\n\n    <div class=\"card market-card\" id=\"mcard\">\n      <div class=\"mc-top\">\n        <span class=\"tag\">Технологии</span>\n        <span class=\"mono\" style=\"font-size:12px;color:var(--dim)\">Закрытие · 31.12</span>\n      </div>\n      <div class=\"mc-q\">Выйдет ли новая модель ИИ до конца квартала?</div>\n\n      <div class=\"mc-price\">\n        <b><span id=\"pv\">62</span>%</b>\n        <span class=\"chg\">▲ 4.5% за 24ч</span>\n      </div>\n\n      <svg class=\"spark\" viewBox=\"0 0 340 78\" fill=\"none\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\"  stop-color=\"hsl(160 84% 44%)\" stop-opacity=\".28\"/>\n            <stop offset=\"100%\" stop-color=\"hsl(160 84% 44%)\" stop-opacity=\"0\"/>\n          </linearGradient>\n        </defs>\n        <path d=\"M0 62 L28 58 L56 64 L84 49 L112 54 L140 41 L168 45 L196 33 L224 37 L252 26 L280 30 L308 18 L340 12 L340 78 L0 78 Z\" fill=\"url(#g)\"/>\n        <path id=\"sparkline\" d=\"M0 62 L28 58 L56 64 L84 49 L112 54 L140 41 L168 45 L196 33 L224 37 L252 26 L280 30 L308 18 L340 12\"\n              stroke=\"hsl(160 84% 44%)\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n        <circle cx=\"340\" cy=\"12\" r=\"3.5\" fill=\"hsl(160 84% 44%)\"/>\n      </svg>\n\n      <div class=\"bar\"><i id=\"bar\"></i></div>\n      <div class=\"bar-legend\">\n        <span class=\"accent\">YES 62%</span>\n        <span style=\"color:var(--red)\">NO 38%</span>\n      </div>\n\n      <div class=\"mc-actions\">\n        <div class=\"side side-yes\">Купить YES · 0.62 WX</div>\n        <div class=\"side side-no\">Купить NO · 0.38 WX</div>\n      </div>\n\n      <div class=\"mc-foot\">\n        <span>Объём 128 400 WX</span>\n        <span>Стакан · 214 ордеров</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- бегущая строка -->\n  <div class=\"ticker\">\n    <div class=\"ticker-track\" id=\"track\"></div>\n  </div>\n</div>\n\n<!-- ═════════════ СТАТИСТИКА ═════════════ -->\n<section style=\"padding-top:84px\">\n  <div class=\"container\">\n    <div class=\"stats rv\">\n      <div class=\"stat\"><b data-count=\"1200\" data-suffix=\"+\">0</b><span>активных рынков</span></div>\n      <div class=\"stat\"><b data-count=\"24\" data-suffix=\"/7\">0</b><span>торги без перерыва</span></div>\n      <div class=\"stat\"><b data-count=\"180\" data-suffix=\" мс\">0</b><span>обновление цены по WebSocket</span></div>\n      <div class=\"stat\"><b data-count=\"0\" data-suffix=\" ₽\">0</b><span>стоимость входа</span></div>\n    </div>\n  </div>\n</section>\n\n<!-- ═════════════ КАК ЭТО РАБОТАЕТ ═════════════ -->\n<section id=\"how\">\n  <div class=\"container\">\n    <div class=\"sec-head rv\">\n      <span class=\"eyebrow\">01 — Как это работает</span>\n      <h2>Три шага от мнения<br>до позиции</h2>\n      <p>Цена доли — это и есть вероятность события по мнению рынка. Купили за 0.62 WX,\n         событие произошло — доля погашается за 1.00 WX.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step rv\">\n        <div class=\"step-n\">ШАГ 01</div>\n        <h3>Выберите событие</h3>\n        <p>Политика, спорт, технологии, экономика и крипта. Сотни рынков с понятными\n           правилами расчёта и датой закрытия.</p>\n      </div>\n      <div class=\"step rv\">\n        <div class=\"step-n\">ШАГ 02</div>\n        <h3>Займите сторону</h3>\n        <p>YES или NO. Ордер уходит в биржевой стакан — по рынку или по своей цене.\n           Позиция видна в портфеле сразу.</p>\n      </div>\n      <div class=\"step rv\">\n        <div class=\"step-n\">ШАГ 03</div>\n        <h3>Заберите результат</h3>\n        <p>Продайте долю в любой момент по текущей цене или дождитесь расчёта\n           события и погашения по 1.00 WX.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═════════════ ВОЗМОЖНОСТИ ═════════════ -->\n<section id=\"features\">\n  <div class=\"container\">\n    <div class=\"sec-head rv\">\n      <span class=\"eyebrow\">02 — Возможности</span>\n      <h2>Биржевая механика,<br>человеческий интерфейс</h2>\n      <p>Под капотом — настоящий стакан заявок, WebSocket-поток и честный расчёт.\n         Сверху — интерфейс, в котором разберётся любой.</p>\n    </div>\n    <div class=\"features\">\n      <div class=\"feat rv\">\n        <div class=\"feat-ico\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 17l6-6 4 4 8-8\"/><path d=\"M21 7v5h-5\"/></svg></div>\n        <h3>Биржевой стакан</h3>\n        <p>Лимитные и рыночные ордера, реальная глубина и спред — не имитация цены.</p>\n      </div>\n      <div class=\"feat rv\">\n        <div class=\"feat-ico\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M13 2L4 14h7l-1 8 9-12h-7z\"/></svg></div>\n        <h3>Реальное время</h3>\n        <p>Цены, сделки и графики прилетают по WebSocket — страницу обновлять не нужно.</p>\n      </div>\n      <div class=\"feat rv\">\n        <div class=\"feat-ico\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2\"/></svg></div>\n        <h3>Портфель и P&L</h3>\n        <p>Все позиции, средняя цена входа, прибыль и история сделок — на одном экране.</p>\n      </div>\n      <div class=\"feat rv\">\n        <div class=\"feat-ico\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 2l2.4 6.9H21l-5.3 4 2 6.9-5.7-4.3L6.3 20l2-7-5.3-4h6.6z\"/></svg></div>\n        <h3>Свои рынки</h3>\n        <p>Создайте вопрос с чёткими правилами — и пусть сообщество торгует вашей идеей.</p>\n      </div>\n      <div class=\"feat rv\">\n        <div class=\"feat-ico\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 00-3-3.9\"/></svg></div>\n        <h3>Лидерборд и сообщество</h3>\n        <p>Рейтинг трейдеров, комментарии к рынкам и уведомления о движении цены.</p>\n      </div>\n      <div class=\"feat rv\">\n        <div class=\"feat-ico\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 018 0v3\"/></svg></div>\n        <h3>Прозрачный расчёт</h3>\n        <p>Правила исхода описаны заранее, история цен открыта, комиссии без сюрпризов.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═════════════ РЫНКИ / ЛИДЕРБОРД ═════════════ -->\n<section id=\"markets\">\n  <div class=\"container split\">\n    <div class=\"rv\">\n      <span class=\"eyebrow\">03 — Соревнование</span>\n      <h2 style=\"font-size:clamp(30px,4vw,46px);margin-top:18px\">Точность видна<br>в таблице</h2>\n      <p style=\"margin-top:18px;font-size:18px;color:var(--muted)\">\n        Каждая сделка — ставка на собственную правоту. Веллекс считает её за вас\n        и показывает, кто действительно разбирается в теме.\n      </p>\n      <ul class=\"checklist\">\n        <li><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg> Ежедневный бонус WX за активность</li>\n        <li><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg> Сезонный рейтинг по доходности и точности</li>\n        <li><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg> Публичный профиль со статистикой сделок</li>\n      </ul>\n      <div style=\"margin-top:34px\"><a class=\"btn btn-primary\" href=\"#cta\">Занять место в таблице</a></div>\n    </div>\n\n    <div class=\"lb rv\">\n      <div class=\"lb-row top\"><span class=\"lb-rank\">01</span><span class=\"lb-av\">А</span><span class=\"lb-name\">alpha_seeker</span><span class=\"lb-val\">+248 910 WX</span></div>\n      <div class=\"lb-row top\"><span class=\"lb-rank\">02</span><span class=\"lb-av\">М</span><span class=\"lb-name\">market_mind</span><span class=\"lb-val\">+201 455 WX</span></div>\n      <div class=\"lb-row top\"><span class=\"lb-rank\">03</span><span class=\"lb-av\">Д</span><span class=\"lb-name\">delta_one</span><span class=\"lb-val\">+176 020 WX</span></div>\n      <div class=\"lb-row\"><span class=\"lb-rank\">04</span><span class=\"lb-av\">Т</span><span class=\"lb-name\">tail_risk</span><span class=\"lb-val\">+134 780 WX</span></div>\n      <div class=\"lb-row\"><span class=\"lb-rank\">05</span><span class=\"lb-av\">С</span><span class=\"lb-name\">signal_hunter</span><span class=\"lb-val\">+119 300 WX</span></div>\n      <div class=\"lb-row\"><span class=\"lb-rank\">06</span><span class=\"lb-av\">В</span><span class=\"lb-name\">vega_long</span><span class=\"lb-val\">+98 640 WX</span></div>\n    </div>\n  </div>\n</section>\n\n<!-- ═════════════ FAQ ═════════════ -->\n<section id=\"faq\">\n  <div class=\"container\">\n    <div class=\"sec-head rv\">\n      <span class=\"eyebrow\">04 — Вопросы</span>\n      <h2>Коротко о главном</h2>\n    </div>\n    <div class=\"faq rv\">\n      <details open>\n        <summary>Что такое прогнозный рынок? <span class=\"pm\">+</span></summary>\n        <p>Рынок, где торгуют исходами событий. Доля «YES» стоит от 0 до 1 WX, и её цена\n           равна вероятности события по мнению всех участников. Если событие произошло,\n           доля погашается по 1.00 WX, если нет — по нулю.</p>\n      </details>\n      <details>\n        <summary>WX — это реальные деньги? <span class=\"pm\">+</span></summary>\n        <p>Нет. WX — внутренняя игровая валюта платформы. Стартовый баланс начисляется\n           бесплатно, ежедневный бонус тоже. Пополнение баланса WX — опция, а не условие игры.</p>\n      </details>\n      <details>\n        <summary>Как формируется цена? <span class=\"pm\">+</span></summary>\n        <p>Через биржевой стакан: ваши заявки встречаются с заявками других участников.\n           Цена последней сделки и есть текущая вероятность. Никакого «казино-коэффициента».</p>\n      </details>\n      <details>\n        <summary>Можно ли выйти из позиции до события? <span class=\"pm\">+</span></summary>\n        <p>Да, в любой момент. Продайте долю по рыночной цене или выставьте лимитную заявку\n           и зафиксируйте результат, не дожидаясь расчёта.</p>\n      </details>\n      <details>\n        <summary>Кто может создать рынок? <span class=\"pm\">+</span></summary>\n        <p>Любой зарегистрированный пользователь. Опишите вопрос, источник истины и дату\n           закрытия — после проверки рынок появится в общем списке.</p>\n      </details>\n    </div>\n  </div>\n</section>\n\n<!-- ═════════════ ФИНАЛЬНЫЙ CTA ═════════════ -->\n<section id=\"cta\" style=\"padding-top:40px\">\n  <div class=\"container\">\n    <div class=\"cta-box rv\">\n      <img src=\"assets/logo.png\" alt=\"Веллекс\">\n      <h2>Вы уже знаете,<br>чем всё закончится?</h2>\n      <p>Регистрация занимает минуту. Стартовый баланс WX — сразу, первый рынок — следом.</p>\n      <div class=\"cta-actions\">\n        <a class=\"btn btn-primary btn-lg\" href=\"#\">Создать аккаунт</a>\n        <a class=\"btn btn-ghost btn-lg\" href=\"#\">Посмотреть рынки</a>\n      </div>\n      <p class=\"mono\" style=\"margin-top:26px;font-size:12px;color:var(--dim)\">\n        Вероятность становится ценой.\n      </p>\n    </div>\n  </div>\n</section>\n</main>\n\n<!-- ═════════════ ПОДВАЛ ═════════════ -->\n<footer>\n  <div class=\"container\">\n    <div class=\"foot-top\">\n      <div class=\"foot-brand\">\n        <div class=\"brand\">\n          <img src=\"assets/logo.png\" alt=\"Веллекс\" width=\"38\" height=\"38\">\n          <span>ВЕЛЛЕКС</span>\n        </div>\n        <p>Платформа прогнозных рынков. Технологичный, премиальный, экспертный подход\n           к торговле вероятностями.</p>\n      </div>\n      <div class=\"foot-cols\">\n        <div class=\"foot-col\">\n          <h4>Продукт</h4>\n          <a href=\"#markets\">Рынки</a>\n          <a href=\"#features\">Возможности</a>\n          <a href=\"#how\">Как это работает</a>\n          <a href=\"#cta\">Лидерборд</a>\n        </div>\n        <div class=\"foot-col\">\n          <h4>Компания</h4>\n          <a href=\"#\">О нас</a>\n          <a href=\"#\">Блог</a>\n          <a href=\"#faq\">Поддержка</a>\n          <a href=\"mailto:hello@wellex.com\">hello@wellex.com</a>\n        </div>\n        <div class=\"foot-col\">\n          <h4>Правовое</h4>\n          <a href=\"/legal/terms\">Условия использования</a>\n          <a href=\"/legal/privacy\">Политика конфиденциальности</a>\n          <a href=\"/legal/market-rules\">Правила рынков</a>\n          <a href=\"/legal/cookies\">Политика cookie</a>\n          <a href=\"#\" id=\"cookie-settings-link\">Настройки cookie</a>\n        </div>\n      </div>\n    </div>\n    <div class=\"foot-bot\">\n      <span class=\"disclaimer\">\n        Торговля ведётся на игровую валюту WX и не является финансовой услугой,\n        инвестиционной рекомендацией или азартной игрой на реальные деньги. 18+.\n      </span>\n      <span>© 2026 ВЕЛЛЕКС</span>\n    </div>\n  </div>\n</footer>\n\n<div class=\"cookie-banner\" id=\"cookie-banner\" role=\"region\" aria-label=\"Уведомление об использовании cookie\">\n  <div class=\"container cookie-in\">\n    <div class=\"cookie-text\">\n      <strong>Мы используем файлы cookie</strong>\n      Необходимые cookie нужны для работы сайта. Яндекс.Метрика (аналитика) подключается только с вашего согласия.\n      <a href=\"/legal/cookies\">Политика cookie</a> · <a href=\"/legal/privacy\">Политика конфиденциальности</a>\n    </div>\n    <div class=\"cookie-actions\">\n      <button type=\"button\" class=\"btn btn-cookie-ghost\" id=\"cookie-reject\">Только необходимые</button>\n      <button type=\"button\" class=\"btn btn-primary\" id=\"cookie-accept\">Принять все</button>\n    </div>\n  </div>\n</div>\n\n</div>\n\n<script>\n(function(){\n  /* шапка при скролле */\n  var nav = document.getElementById('nav');\n  var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 12); };\n  onScroll(); window.addEventListener('scroll', onScroll, {passive:true});\n\n  /* бегущая строка — дублируем список для бесшовного цикла */\n  var items = [\n    ['Ставка ЦБ снизится в этом квартале','64%','up'],\n    ['Биткоин выше $150k до конца года','38%','down'],\n    ['Новая модель ИИ выйдет до декабря','62%','up'],\n    ['Команда А выиграет чемпионат','27%','down'],\n    ['Запуск ракеты состоится по графику','81%','up'],\n    ['Инфляция ниже 5% по итогам года','44%','up'],\n    ['Курс евро выше 110 ₽','33%','down'],\n    ['Релиз игры перенесут','71%','up']\n  ];\n  var track = document.getElementById('track');\n  var html = items.map(function(i){\n    return '<div class=\"tick\"><span>'+i[0]+'</span><b class=\"'+i[2]+'\">'+\n           (i[2]==='up'?'▲':'▼')+' '+i[1]+'</b></div>';\n  }).join('');\n  track.innerHTML = html + html;\n\n  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  /* появление секций + счётчики */\n  var io = new IntersectionObserver(function(entries){\n    entries.forEach(function(e){\n      if(!e.isIntersecting) return;\n      e.target.classList.add('in');\n      e.target.querySelectorAll('[data-count]').forEach(count);\n      io.unobserve(e.target);\n    });\n  }, {threshold:.18, rootMargin:'0px 0px -40px 0px'});\n  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });\n\n  function count(el){\n    var target = parseFloat(el.dataset.count), suffix = el.dataset.suffix || '';\n    if(reduced || !target){ el.textContent = fmt(target) + suffix; return; }\n    var start = performance.now(), dur = 1400;\n    (function tick(now){\n      var p = Math.min((now - start) / dur, 1);\n      var eased = 1 - Math.pow(1 - p, 3);\n      el.textContent = fmt(Math.round(target * eased)) + suffix;\n      if(p < 1) requestAnimationFrame(tick);\n    })(start);\n  }\n  function fmt(n){ return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ' '); }\n\n  /* карточка рынка: заполнение шкалы + живой тик цены */\n  var bar = document.getElementById('bar'), pv = document.getElementById('pv');\n  setTimeout(function(){ bar.style.width = '62%'; }, 350);\n  if(!reduced){\n    setInterval(function(){\n      var v = 62 + (Math.random() * 1.6 - .8);\n      pv.textContent = v.toFixed(1);\n    }, 2600);\n  }\n})();\n</script>\n<script>\n(function(){\n  var METRIKA_ID = 113005346;\n  var STORAGE_KEY = 'wellex-cookie-consent';\n  var banner = document.getElementById('cookie-banner');\n  var metrikaStarted = false;\n\n  function loadConsent(){\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (!raw) return { status: 'pending' };\n      return JSON.parse(raw);\n    } catch (e) {\n      return { status: 'pending' };\n    }\n  }\n\n  function saveConsent(state){\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}\n  }\n\n  function analyticsAllowed(state){\n    return state && state.status === 'accepted' && state.consent && state.consent.analytics === true;\n  }\n\n  function showBanner(){\n    if (!banner) return;\n    banner.classList.add('is-visible');\n  }\n\n  function hideBanner(){\n    if (!banner) return;\n    banner.classList.remove('is-visible');\n  }\n\n  function initYandexMetrika(){\n    if (metrikaStarted || !METRIKA_ID) return;\n    metrikaStarted = true;\n    window.dataLayer = window.dataLayer || [];\n    (function(m,e,t,r,i,k,a){\n      m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};\n      m[i].l=1*new Date();\n      for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }\n      k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a);\n    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + METRIKA_ID, 'ym');\n\n    ym(METRIKA_ID, 'init', {\n      ssr: true,\n      webvisor: true,\n      clickmap: true,\n      ecommerce: 'dataLayer',\n      referrer: document.referrer,\n      url: location.href,\n      accurateTrackBounce: true,\n      trackLinks: true\n    });\n  }\n\n  function applyConsent(state){\n    saveConsent(state);\n    hideBanner();\n    if (analyticsAllowed(state)) initYandexMetrika();\n  }\n\n  function acceptAll(){\n    applyConsent({\n      status: 'accepted',\n      consent: { necessary: true, analytics: true, functional: true }\n    });\n  }\n\n  function rejectAnalytics(){\n    applyConsent({\n      status: 'accepted',\n      consent: { necessary: true, analytics: false, functional: false }\n    });\n  }\n\n  var consent = loadConsent();\n  if (consent.status === 'pending') showBanner();\n  else if (analyticsAllowed(consent)) initYandexMetrika();\n\n  var acceptBtn = document.getElementById('cookie-accept');\n  var rejectBtn = document.getElementById('cookie-reject');\n  var settingsLink = document.getElementById('cookie-settings-link');\n  if (acceptBtn) acceptBtn.addEventListener('click', acceptAll);\n  if (rejectBtn) rejectBtn.addEventListener('click', rejectAnalytics);\n  if (settingsLink) settingsLink.addEventListener('click', function(e){\n    e.preventDefault();\n    showBanner();\n  });\n})();\n</script>\n<noscript><div><img src=\"https://mc.yandex.ru/watch/113005346\" style=\"position:absolute;left:-9999px;\" alt=\"\"></div></noscript>\n</body>\n</html>\n"
