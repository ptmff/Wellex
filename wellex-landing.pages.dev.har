ntent\":\"\\n        \"},{\"id\":787,\"prev\":767,\"next\":null,\"parent\":729,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      \"},{\"id\":788,\"prev\":729,\"next\":null,\"parent\":713,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":789,\"prev\":713,\"next\":790,\"parent\":711,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":790,\"prev\":789,\"next\":798,\"parent\":711,\"name\":\"div\",\"attributes\":{\"class\":\"foot-bot\"}},{\"id\":791,\"prev\":null,\"next\":792,\"parent\":790,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      \"},{\"id\":792,\"prev\":791,\"next\":794,\"parent\":790,\"name\":\"span\",\"attributes\":{\"class\":\"disclaimer\"}},{\"id\":793,\"prev\":null,\"next\":null,\"parent\":792,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n        Торговля ведётся на игровую валюту WX и не является финансовой услугой,\\n        инвестиционной рекомендацией или азартной игрой на реальные деньги. 18+.\\n      \"},{\"id\":794,\"prev\":792,\"next\":795,\"parent\":790,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      \"},{\"id\":795,\"prev\":794,\"next\":797,\"parent\":790,\"name\":\"span\",\"attributes\":{}},{\"id\":796,\"prev\":null,\"next\":null,\"parent\":795,\"name\":\"#text\",\"attributes\":{},\"content\":\"© 2026 ВЕЛЛЕКС\"},{\"id\":797,\"prev\":795,\"next\":null,\"parent\":790,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":798,\"prev\":790,\"next\":null,\"parent\":711,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n  \"},{\"id\":799,\"prev\":711,\"next\":null,\"parent\":709,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\"},{\"id\":800,\"prev\":709,\"next\":801,\"parent\":43,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\\n\"},{\"id\":801,\"prev\":800,\"next\":827,\"parent\":43,\"name\":\"div\",\"attributes\":{\"class\":\"cookie-banner\",\"id\":\"cookie-banner\",\"role\":\"region\",\"aria-label\":\"Уведомление об использовании cookie\"}},{\"id\":802,\"prev\":null,\"next\":803,\"parent\":801,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n  \"},{\"id\":803,\"prev\":802,\"next\":826,\"parent\":801,\"name\":\"div\",\"attributes\":{\"class\":\"container cookie-in\"}},{\"id\":804,\"prev\":null,\"next\":805,\"parent\":803,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":805,\"prev\":804,\"next\":816,\"parent\":803,\"name\":\"div\",\"attributes\":{\"class\":\"cookie-text\"}},{\"id\":806,\"prev\":null,\"next\":807,\"parent\":805,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      \"},{\"id\":807,\"prev\":806,\"next\":809,\"parent\":805,\"name\":\"strong\",\"attributes\":{}},{\"id\":808,\"prev\":null,\"next\":null,\"parent\":807,\"name\":\"#text\",\"attributes\":{},\"content\":\"Мы используем файлы cookie\"},{\"id\":809,\"prev\":807,\"next\":810,\"parent\":805,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      Необходимые cookie нужны для работы сайта. Яндекс.Метрика (аналитика) подключается только с вашего согласия.\\n      \"},{\"id\":810,\"prev\":809,\"next\":812,\"parent\":805,\"name\":\"a\",\"attributes\":{\"href\":\"#\"}},{\"id\":811,\"prev\":null,\"next\":null,\"parent\":810,\"name\":\"#text\",\"attributes\":{},\"content\":\"Политика cookie\"},{\"id\":812,\"prev\":810,\"next\":813,\"parent\":805,\"name\":\"#text\",\"attributes\":{},\"content\":\" · \"},{\"id\":813,\"prev\":812,\"next\":815,\"parent\":805,\"name\":\"a\",\"attributes\":{\"href\":\"#\"}},{\"id\":814,\"prev\":null,\"next\":null,\"parent\":813,\"name\":\"#text\",\"attributes\":{},\"content\":\"Политика конфиденциальности\"},{\"id\":815,\"prev\":813,\"next\":null,\"parent\":805,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":816,\"prev\":805,\"next\":817,\"parent\":803,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":817,\"prev\":816,\"next\":825,\"parent\":803,\"name\":\"div\",\"attributes\":{\"class\":\"cookie-actions\"}},{\"id\":818,\"prev\":null,\"next\":819,\"parent\":817,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      \"},{\"id\":819,\"prev\":818,\"next\":821,\"parent\":817,\"name\":\"button\",\"attributes\":{\"type\":\"button\",\"class\":\"btn btn-cookie-ghost\",\"id\":\"cookie-reject\"}},{\"id\":820,\"prev\":null,\"next\":null,\"parent\":819,\"name\":\"#text\",\"attributes\":{},\"content\":\"Только необходимые\"},{\"id\":821,\"prev\":819,\"next\":822,\"parent\":817,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n      \"},{\"id\":822,\"prev\":821,\"next\":824,\"parent\":817,\"name\":\"button\",\"attributes\":{\"type\":\"button\",\"class\":\"btn btn-primary\",\"id\":\"cookie-accept\"}},{\"id\":823,\"prev\":null,\"next\":null,\"parent\":822,\"name\":\"#text\",\"attributes\":{},\"content\":\"Принять все\"},{\"id\":824,\"prev\":822,\"next\":null,\"parent\":817,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n    \"},{\"id\":825,\"prev\":817,\"next\":null,\"parent\":803,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n  \"},{\"id\":826,\"prev\":803,\"next\":null,\"parent\":801,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\"},{\"id\":827,\"prev\":801,\"next\":null,\"parent\":43,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\\n\"},{\"id\":828,\"prev\":43,\"next\":829,\"parent\":39,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\\n\"},{\"id\":829,\"prev\":828,\"next\":830,\"parent\":39,\"name\":\"script\",\"attributes\":{\"async\":\"\"}},{\"id\":830,\"prev\":829,\"next\":832,\"parent\":39,\"name\":\"script\",\"attributes\":{}},{\"id\":831,\"prev\":null,\"next\":null,\"parent\":830,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n(function(){\\n  /* шапка при скролле */\\n  var nav = document.getElementById('nav');\\n  var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 12); };\\n  onScroll(); window.addEventListener('scroll', onScroll, {passive:true});\\n\\n  /* бегущая строка — дублируем список для бесшовного цикла */\\n  var items = [\\n    ['Ставка ЦБ снизится в этом квартале','64%','up'],\\n    ['Биткоин выше $150k до конца года','38%','down'],\\n    ['Новая модель ИИ выйдет до декабря','62%','up'],\\n    ['Команда А выиграет чемпионат','27%','down'],\\n    ['Запуск ракеты состоится по графику','81%','up'],\\n    ['Инфляция ниже 5% по итогам года','44%','up'],\\n    ['Курс евро выше 110 ₽','33%','down'],\\n    ['Релиз игры перенесут','71%','up']\\n  ];\\n  var track = document.getElementById('track');\\n  var html = items.map(function(i){\\n    return '<div class=\\\"tick\\\"><span>'+i[0]+'</span><b class=\\\"'+i[2]+'\\\">'+\\n           (i[2]==='up'?'▲':'▼')+' '+i[1]+'</b></div>';\\n  }).join('');\\n  track.innerHTML = html + html;\\n\\n  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\\n\\n  /* появление секций + счётчики */\\n  var io = new IntersectionObserver(function(entries){\\n    entries.forEach(function(e){\\n      if(!e.isIntersecting) return;\\n      e.target.classList.add('in');\\n      e.target.querySelectorAll('[data-count]').forEach(count);\\n      io.unobserve(e.target);\\n    });\\n  }, {threshold:.18, rootMargin:'0px 0px -40px 0px'});\\n  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });\\n\\n  function count(el){\\n    var target = parseFloat(el.dataset.count), suffix = el.dataset.suffix || '';\\n    if(reduced || !target){ el.textContent = fmt(target) + suffix; return; }\\n    var start = performance.now(), dur = 1400;\\n    (function tick(now){\\n      var p = Math.min((now - start) / dur, 1);\\n      var eased = 1 - Math.pow(1 - p, 3);\\n      el.textContent = fmt(Math.round(target * eased)) + suffix;\\n      if(p < 1) requestAnimationFrame(tick);\\n    })(start);\\n  }\\n  function fmt(n){ return String(n).replace(/\\\\B(?=(\\\\d{3})+(?!\\\\d))/g, ' '); }\\n\\n  /* карточка рынка: заполнение шкалы + живой тик цены */\\n  var bar = document.getElementById('bar'), pv = document.getElementById('pv');\\n  setTimeout(function(){ bar.style.width = '62%'; }, 350);\\n  if(!reduced){\\n    setInterval(function(){\\n      var v = 62 + (Math.random() * 1.6 - .8);\\n      pv.textContent = v.toFixed(1);\\n    }, 2600);\\n  }\\n})();\\n\"},{\"id\":832,\"prev\":830,\"next\":833,\"parent\":39,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\"},{\"id\":833,\"prev\":832,\"next\":835,\"parent\":39,\"name\":\"script\",\"attributes\":{}},{\"id\":834,\"prev\":null,\"next\":null,\"parent\":833,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n(function(){\\n  var METRIKA_ID = 113005346;\\n  var STORAGE_KEY = 'wellex-cookie-consent';\\n  var banner = document.getElementById('cookie-banner');\\n  var metrikaStarted = false;\\n\\n  function loadConsent(){\\n    try {\\n      var raw = localStorage.getItem(STORAGE_KEY);\\n      if (!raw) return { status: 'pending' };\\n      return JSON.parse(raw);\\n    } catch (e) {\\n      return { status: 'pending' };\\n    }\\n  }\\n\\n  function saveConsent(state){\\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}\\n  }\\n\\n  function analyticsAllowed(state){\\n    return state && state.status === 'accepted' && state.consent && state.consent.analytics === true;\\n  }\\n\\n  function showBanner(){\\n    if (!banner) return;\\n    banner.classList.add('is-visible');\\n  }\\n\\n  function hideBanner(){\\n    if (!banner) return;\\n    banner.classList.remove('is-visible');\\n  }\\n\\n  function initYandexMetrika(){\\n    if (metrikaStarted || !METRIKA_ID) return;\\n    metrikaStarted = true;\\n    window.dataLayer = window.dataLayer || [];\\n    (function(m,e,t,r,i,k,a){\\n      m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};\\n      m[i].l=1*new Date();\\n      for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }\\n      k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a);\\n    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + METRIKA_ID, 'ym');\\n\\n    ym(METRIKA_ID, 'init', {\\n      ssr: true,\\n      webvisor: true,\\n      clickmap: true,\\n      ecommerce: 'dataLayer',\\n      referrer: document.referrer,\\n      url: location.href,\\n      accurateTrackBounce: true,\\n      trackLinks: true\\n    });\\n  }\\n\\n  function applyConsent(state){\\n    saveConsent(state);\\n    hideBanner();\\n    if (analyticsAllowed(state)) initYandexMetrika();\\n  }\\n\\n  function acceptAll(){\\n    applyConsent({\\n      status: 'accepted',\\n      consent: { necessary: true, analytics: true, functional: true }\\n    });\\n  }\\n\\n  function rejectAnalytics(){\\n    applyConsent({\\n      status: 'accepted',\\n      consent: { necessary: true, analytics: false, functional: false }\\n    });\\n  }\\n\\n  var consent = loadConsent();\\n  if (consent.status === 'pending') showBanner();\\n  else if (analyticsAllowed(consent)) initYandexMetrika();\\n\\n  var acceptBtn = document.getElementById('cookie-accept');\\n  var rejectBtn = document.getElementById('cookie-reject');\\n  var settingsLink = document.getElementById('cookie-settings-link');\\n  if (acceptBtn) acceptBtn.addEventListener('click', acceptAll);\\n  if (rejectBtn) rejectBtn.addEventListener('click', rejectAnalytics);\\n  if (settingsLink) settingsLink.addEventListener('click', function(e){\\n    e.preventDefault();\\n    showBanner();\\n  });\\n})();\\n\"},{\"id\":835,\"prev\":833,\"next\":836,\"parent\":39,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\"},{\"id\":836,\"prev\":835,\"next\":838,\"parent\":39,\"name\":\"noscript\",\"attributes\":{}},{\"id\":837,\"prev\":null,\"next\":null,\"parent\":836,\"name\":\"#text\",\"attributes\":{},\"content\":\"<div><img src=\\\"https://mc.yandex.ru/watch/113005346\\\" style=\\\"position:absolute;left:-9999px;\\\" alt=\\\"\\\"></div>\"},{\"id\":838,\"prev\":836,\"next\":null,\"parent\":39,\"name\":\"#text\",\"attributes\":{},\"content\":\"\\n\\n\\n